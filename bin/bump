#!/usr/bin/env bash
# Releases the plugin: tags manifest.json's version if it isn't tagged yet, like the first release, or else bumps it
# with npm version, patch by default, or minor or major, then pushes main and the tag, which runs the release workflow.
set -euo pipefail
cd "$(dirname "$0")/.."

git diff --quiet HEAD || { echo 'Commit your changes first, so the release has them.' >&2; exit 1; }

version=$(node -p "require('./manifest.json').version")
if git rev-parse --quiet --verify "refs/tags/$version" >/dev/null; then
  npm version "${1:-patch}"
else
  # Annotated, like npm version's tags, as --follow-tags only pushes those.
  git tag --annotate "$version" --message "$version"
fi

git push --follow-tags origin main

#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds main.js, which Obsidian loads, from src/, with Raindown inside it: ruby.wasm's modules, Ruby compiled to
# WebAssembly, compressed with gzip, in Z85, with only the Ruby files Raindown loads, ruby.wasm's browser bundle and the
# worker that runs it. One module's without Asyncify, which the worker uses where the engine has JSPI, and the other's
# Asyncify's, where it hasn't, like Safari.
#   1. scripts/trace.rb writes back test/vault with a Raindown checkout, RAINDOWN_DIR or ../raindown, natively, in the
#      same Ruby as ruby.wasm's, and lists what it wrote and the standard library files and gems that loaded, in
#      build/loaded.json.
#   2. Those files, and src/engine.rb, are copied into build/root, as they'll be inside Ruby: the standard library at
#      /usr/local/lib/ruby, each gem at /gems/NAME and the engine at /engine.
#   3. With WASMTIME, each Ruby file's compiled to bytecode, at /bytecode, by ruby.wasm's WASI build, which is the same
#      Ruby as the module, so src/bytecode.rb loads it rather than its source, halving how long Raindown takes to load.
#      Its source is then left empty, so only its bytecode's packed.
#   4. build/root's files go into main.js, which the worker gives Ruby, rather than either module, as wasi-vfs can't pack
#      the one without Asyncify. The modules are built by scripts/ruby_wasm.rb the first time, with only the extensions
#      Raindown uses, and Ruby patched with wasm/patches, which takes a while, the one without Asyncify from the
#      wasi-sdk and Binaryen downloaded into build/runtime, or WASI_SDK_PATH and BINARYEN.
#   5. scripts/smoke.js runs main.js's worker on test/vault, with Node, and checks it wrote back what step 1 did, and
#      scripts/jumps.js checks Ruby's jumps in the module are native Ruby's, with each module, the one without Asyncify
#      with Node 26's JSPI. They're skipped without Node, except in CI.
# Releases are built by CI, with Raindown at RAINDOWN_VERSION, and main.js isn't committed.
# ruby.wasm's WASI build and npm package are downloaded into build/runtime, or are RUBY_WASI and RUBY_NPM, and its
# modules are built there, or are RUBY_WASM and RUBY_WASM_JSPI, with rbwasm and the js gem from wasm/Gemfile.
#   BUNDLE_GEMFILE=../raindown/Gemfile bundle install
#   BUNDLE_GEMFILE=wasm/Gemfile bundle install
#   BUNDLE_GEMFILE=wasm/Gemfile RAINDOWN_DIR=../raindown WASMTIME=~/.wasmtime/bin/wasmtime bundle exec bin/build
require 'digest'
require 'fileutils'
require 'zlib'
require 'json'

RUBY_WASM_VERSION = '2.10.1'
# Ruby's version in ruby.wasm, as its releases and npm package name it, and its standard library's folder.
RUBY = '4.0'
RUBY_LIB = "usr/local/lib/ruby/#{RUBY}.0"
ROOT = File.expand_path('..', __dir__)
BUILD = File.join(ROOT, 'build')
STAGE = File.join(BUILD, 'root')
RAINDOWN = File.expand_path(ENV.fetch('RAINDOWN_DIR', '../raindown'), ROOT)
# Raindown's services for JavaScript nodes, which the worker answers, before its own code.
SERVICES = File.join(RAINDOWN, 'lib', 'raindown', 'js', 'services.js')
# Raindown's editing of Markdown as it's typed, like lining up tables, which the plugin requires as './editing'.
EDITING = File.join(RAINDOWN, 'lib', 'raindown', 'js', 'editing.js')
# Ruby is the plugin's .ruby-version, the same as ruby.wasm's, with Raindown's gems and rbwasm installed into it, which
# mise gives it, unless there's no mise, like in CI.
def mise_exec
  return [] unless system('mise', '--version', out: File::NULL, err: File::NULL)

  %w[mise exec --]
end
MISE = mise_exec.freeze
BUNDLED = [*MISE, 'bundle', 'exec'].freeze
# rbwasm and the js gem, at RUBY_WASM_VERSION, for building ruby.wasm's module and packing Raindown into it.
WASM_GEMS = { 'BUNDLE_GEMFILE' => File.join(ROOT, 'wasm', 'Gemfile') }.freeze
# Its lockfile, as it was, which a build locks again for this computer alone, leaving out the others, so it's written
# back after, and the modules are named by it.
WASM_LOCKFILE = File.join(ROOT, 'wasm', 'Gemfile.lock')
WASM_LOCKED = File.read(WASM_LOCKFILE)
at_exit { File.write(WASM_LOCKFILE, WASM_LOCKED) unless File.read(WASM_LOCKFILE) == WASM_LOCKED }

# Z85, a base 85 with no quotes or backslashes, so it's a JavaScript string as it is, a fifteenth smaller than base64.
# The bytes are padded to a multiple of 4 with zeros, which the worker cuts off.
Z85 = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#'

def z85(bytes)
  padded = bytes + ("\0" * (-bytes.bytesize % 4))
  padded.unpack('N*').map { |number| 4.downto(0).map { Z85[(number / (85**it)) % 85] }.join }.join
end

def run(*command, chdir: ROOT)
  system(*command, chdir:, exception: true)
end

# The folder a release is extracted into in build/runtime, downloaded the first time.
def runtime(name, url)
  folder = File.join(BUILD, 'runtime', name)
  return folder if File.directory?(folder)

  FileUtils.mkdir_p(folder)
  run("curl -fsSL #{url} | tar -xz -C #{folder}")
  folder
end

def ruby_wasi
  ENV['RUBY_WASI'] || File.join(runtime("wasi-#{RUBY}", "https://github.com/ruby/ruby.wasm/releases/download/#{RUBY_WASM_VERSION}/" \
                                                 "ruby-#{RUBY}-wasm32-unknown-wasip1-full.tar.gz"), "ruby-#{RUBY}-wasm32-unknown-wasip1-full")
end

# ruby.wasm's module, built with only the extensions Raindown uses, and Ruby's source patched with wasm/patches, named
# by what it's built from, so a change to them builds it again, or without Asyncify, with jspi, from the wasi-sdk and
# Binaryen it needs.
def ruby_module(jspi: false)
  given = ENV[jspi ? 'RUBY_WASM_JSPI' : 'RUBY_WASM']
  return File.expand_path(given) if given

  patches = Dir.glob('wasm/patches/**/*.patch', base: ROOT).sort
  inputs = [File.read(File.join(ROOT, 'scripts', 'ruby_wasm.rb')), WASM_LOCKED, *patches.map { File.read(File.join(ROOT, it)) }].join
  path = File.join(BUILD, 'module', "ruby-#{'jspi-' if jspi}#{Digest::SHA256.hexdigest(inputs)[0, 12]}.wasm")
  return path if File.exist?(path)

  FileUtils.mkdir_p(File.dirname(path))
  env = WASM_GEMS.merge('RUBY_WASM_ROOT' => File.join(BUILD, 'ruby_wasm'))
  env = env.merge('WASI_SDK_PATH' => wasi_sdk, 'BINARYEN' => binaryen) if jspi
  run(env, *BUNDLED, 'ruby', File.join(ROOT, 'scripts', 'ruby_wasm.rb'), path, *('--jspi' if jspi))
  path
end

# The wasi-sdk and Binaryen the module without Asyncify's built with, for this computer, as their releases name it: a
# wasi-sdk with LLVM 19 or later, whose setjmp keeps its state in the jmp_buf, rather than allocating, and Binaryen
# 131, newer than rbwasm's 108, which it's built and timed with.
WASI_SDK_VERSION = '34'
BINARYEN_VERSION = '131'
HOST_OS = RUBY_PLATFORM.include?('darwin') ? 'macos' : 'linux'
HOST_ARCH = RbConfig::CONFIG['host_cpu'].match?(/arm|aarch64/) ? 'arm64' : 'x86_64'

def wasi_sdk
  return ENV['WASI_SDK_PATH'] if ENV['WASI_SDK_PATH']

  name = "wasi-sdk-#{WASI_SDK_VERSION}.0-#{HOST_ARCH}-#{HOST_OS}"
  File.join(runtime(name, "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-#{WASI_SDK_VERSION}/#{name}.tar.gz"), name)
end

def binaryen
  return ENV['BINARYEN'] if ENV['BINARYEN']

  arch = HOST_ARCH == 'arm64' && HOST_OS == 'linux' ? 'aarch64' : HOST_ARCH
  name = "binaryen-version_#{BINARYEN_VERSION}"
  release = "https://github.com/WebAssembly/binaryen/releases/download/version_#{BINARYEN_VERSION}"
  File.join(runtime("#{name}-#{arch}-#{HOST_OS}", "#{release}/#{name}-#{arch}-#{HOST_OS}.tar.gz"), name)
end

def command?(name)
  system('which', name, out: File::NULL, err: File::NULL)
end

# The file compressed with gzip, which the worker decompresses with the browser's own DecompressionStream, starting
# Raindown about 100 ms sooner than xz, which is a third smaller. Zopfli makes the smallest gzip, a tenth smaller than
# Zlib's, in about half a minute, so CI, which releases it, always uses it, and a build without it uses Zlib's.
def gzipped(path)
  unless ENV['CI'] || command?('zopfli')
    puts 'Compressed with Zlib: no zopfli, which CI compresses with'
    return Zlib.gzip(File.binread(path), level: 9)
  end

  run('zopfli', '--gzip', path)
  File.binread("#{path}.gz")
end

def ruby_npm
  ENV['RUBY_NPM'] || File.join(runtime("npm-#{RUBY}", "https://registry.npmjs.org/@ruby/#{RUBY}-wasm-wasi/-/#{RUBY}-wasm-wasi-#{RUBY_WASM_VERSION}.tgz"),
                               'package', 'dist')
end

def copy(from, to)
  FileUtils.mkdir_p(File.dirname(to))
  FileUtils.cp_r(from, to)
end

# Files Ruby loads before src/bytecode.rb, from their source, which is kept, as are those Raindown reads as text, like
# Lowkey's for a class that includes LowType, which scripts/trace.rb lists.
BEFORE_BYTECODE = %w[rbconfig.rb].freeze

# An edition's Ruby, full or components, as each loads only what its features need, packed in its folder: the plugin's
# in build, Components' in build/components, with what loaded, staged in root, and packed in root.bin. Gives what
# loaded, its load paths and the packed files.
def packed_root(edition, folder)
  stage = File.join(folder, 'root')
  FileUtils.mkdir_p(folder)

  # 1. What loads.
  loaded_file = File.join(folder, 'loaded.json')
  run({ 'BUNDLE_GEMFILE' => File.join(RAINDOWN, 'Gemfile') }, *BUNDLED, 'ruby', '-rrbconfig', '-I', File.join(ROOT, 'src'),
      File.join(ROOT, 'scripts', 'trace.rb'), loaded_file, edition)
  loaded = JSON.parse(File.read(loaded_file))

  # 2. Staged as inside Ruby.
  FileUtils.rm_rf(stage)
  stdlib = File.join(ruby_wasi, RUBY_LIB)
  loaded['stdlib'].each { copy(File.join(stdlib, it), File.join(stage, RUBY_LIB, it)) }
  load_paths = ['/engine']
  loaded['gems'].each do |name, gem|
    # Only the files that loaded, and gem data, like unicode-display_width's tables, beside its code.
    gem['files'].each { copy(File.join(gem['root'], it), File.join(stage, 'gems', name, it)) }
    data = File.join(gem['root'], 'data')
    copy(data, File.join(stage, 'gems', name, 'data')) if File.directory?(data)
    load_paths.concat(gem['require_paths'].map { "/gems/#{name}/#{it}" })
  end
  %w[engine.rb bytecode.rb worker.rb].each { copy(File.join(ROOT, 'src', it), File.join(stage, 'engine', it)) }

  # 3. Bytecode, with the stage as Ruby's / and scripts/ for compile.rb, for only the files that loaded, as the rest
  # are rarely loaded, and they're compiled from source when they are.
  folders = %w[usr gems engine]
  if ENV['WASMTIME']
    compiled = loaded['stdlib'].map { "/#{RUBY_LIB}/#{it}" } + ['/engine/engine.rb'] +
               loaded['gems'].flat_map { |name, gem| gem['files'].map { "/gems/#{name}/#{it}" } }
    File.write(File.join(folder, 'compile.txt'), compiled.join("\n"))
    run(ENV['WASMTIME'], 'run', '--dir', "#{stage}::/", '--dir', "#{File.join(ROOT, 'scripts')}::/scripts",
        '--dir', "#{folder}::/build", File.join(ruby_wasi, 'usr', 'local', 'bin', 'ruby'), '--disable-gems',
        '/scripts/compile.rb', '/bytecode', '/build/compile.txt')
    folders << 'bytecode'
    # Only the bytecode's packed, as each source file's left empty, which Ruby still needs to find it to require it.
    # A file that failed to compile keeps its source.
    emptied = compiled.count do |file|
      next false if BEFORE_BYTECODE.include?(File.basename(file)) || loaded['read'].include?(file)
      next false unless File.exist?(File.join(stage, 'bytecode', "#{file}.yarb"))

      File.write(File.join(stage, file), '')
    end
    puts "Packed #{emptied} files as bytecode only, for #{edition}"
  end

  # 4. Packed into main.js, with the js gem's files, which rbwasm packs into a module otherwise, and a
  # /bundle/setup.rb, which ruby.wasm's browser bundle loads, that finds them.
  copy(File.join(Gem::Specification.find_by_name('js').full_gem_path, 'lib'), File.join(stage, 'bundle', 'js', 'lib'))
  File.write(File.join(stage, 'bundle', 'setup.rb'), "$LOAD_PATH.unshift('/bundle/js/lib')\n")
  folders << 'bundle'
  # They're one after another, compressed together, like the modules, with each one's path and size.
  root_files = folders.flat_map { |at| Dir.glob("#{at}/**/*", base: stage) }.select { File.file?(File.join(stage, it)) }
  root_data = File.join(folder, 'root.bin')
  File.binwrite(root_data, root_files.map { File.binread(File.join(stage, it)) }.join)
  compressed = gzipped(root_data)
  { loadPaths: load_paths, rootFiles: root_files.map { [it, File.size(File.join(stage, it))] }, rootData: z85(compressed),
    rootDataSize: compressed.bytesize }
end

full_root = packed_root('full', BUILD)
components_root = packed_root('components', File.join(BUILD, 'components'))
wasm = File.join(BUILD, 'raindown.wasm')
FileUtils.cp(ruby_module, wasm)
wasm_jspi = File.join(BUILD, 'raindown-jspi.wasm')
FileUtils.cp(ruby_module(jspi: true), wasm_jspi)

# main.js, with the worker's code after Raindown's services.js. The browser bundle only gives DefaultRubyVM, which can't take Ruby's arguments, so it gives RubyVM and the
# WASI classes too. Each of src/'s files is a module, as Node would load it, for Obsidian, which loads one file, as is
# Raindown's editing.js.
browser = File.read(File.join(ruby_npm, 'browser.umd.js'))
browser = browser.sub('exports.DefaultRubyVM = DefaultRubyVM;') do
  'exports.DefaultRubyVM = DefaultRubyVM; Object.assign(exports, { RubyVM, WASI, OpenFile, File, PreopenDirectory, Directory });'
end
abort "ruby.wasm's browser bundle no longer exports DefaultRubyVM where it did" unless browser.include?('Object.assign(exports, { RubyVM')
worker = [browser, File.read(SERVICES), File.read(File.join(ROOT, 'src', 'worker.js'))].join("\n")
compressed = gzipped(wasm)
compressed_jspi = gzipped(wasm_jspi)
runtime = {
  wasm: z85(compressed),
  wasmSize: compressed.bytesize,
  wasmJspi: z85(compressed_jspi),
  wasmJspiSize: compressed_jspi.bytesize,
  worker:
}
edition = File.read(File.join(ROOT, 'src', 'edition.js'))
sources = {
  './runtime' => "module.exports = #{JSON.generate(runtime.merge(full_root))};",
  './edition' => edition,
  './engine' => File.read(File.join(ROOT, 'src', 'engine.js')),
  './editing' => File.read(EDITING),
  './plugin' => File.read(File.join(ROOT, 'src', 'plugin.js'))
}

# A main.js of the sources' modules, as Node would load them, for Obsidian, which loads one file.
def write_main(path, sources)
  modules = sources.map { |name, code| "#{JSON.generate(name)}: function (module, exports, require) {\n#{code}\n}" }
  File.write(path, <<~JS)
    'use strict';

    // Built by bin/build from src/, with Raindown packed into Ruby compiled to WebAssembly. Edit src/, rather than this.
    const sources = {
    #{modules.join(",\n")}
    };
    const loaded = {};
    function load(name) {
      if (!sources[name]) return require(name);
      if (!loaded[name]) {
        loaded[name] = { exports: {} };
        sources[name](loaded[name], loaded[name].exports, load);
      }
      return loaded[name].exports;
    }
    module.exports = load('./plugin');
  JS
end

write_main(File.join(ROOT, 'main.js'), sources)

# Components, the plugin for beginners, the same but for its edition, in build/components, with its manifest, at the
# plugin's version, and styles.
components_edition = edition.sub("const BUILT = 'full';", "const BUILT = 'components';")
abort "src/edition.js no longer names the edition it's built as with const BUILT = 'full';" if components_edition == edition
components = File.join(BUILD, 'components')
write_main(File.join(components, 'main.js'),
           sources.merge('./edition' => components_edition,
                         './runtime' => "module.exports = #{JSON.generate(runtime.merge(components_root))};"))
manifest = JSON.parse(File.read(File.join(ROOT, 'components', 'manifest.json')))
version = JSON.parse(File.read(File.join(ROOT, 'manifest.json'))).fetch('version')
File.write(File.join(components, 'manifest.json'), "#{JSON.pretty_generate({ 'id' => manifest['id'], 'name' => manifest['name'], 'version' => version, **manifest.except('id', 'name') })}\n")
FileUtils.cp(File.join(ROOT, 'styles.css'), components)
puts format('Built main.js: %.2f MB, and Components\' in build/components: %.2f MB, with ruby.wasm\'s modules of %.2f MB, ' \
            'and %.2f MB without Asyncify', File.size(File.join(ROOT, 'main.js')) / 1e6,
            File.size(File.join(components, 'main.js')) / 1e6, File.size(wasm) / 1e6, File.size(wasm_jspi) / 1e6)
# Node runs the smoke test, then Ruby's jumps, which wasm/patches changes, in the module, against native Ruby's, with
# Asyncify's module, with JSPI hidden, as in Safari, then with the one without it, with Node 26's JSPI.
# CI has Node, so a release is always checked, but working on the plugin doesn't need it.
if ENV['CI'] || system('node', '--version', out: File::NULL, err: File::NULL)
  browser_bundle = File.join(ruby_npm, 'browser.umd.js')
  run({ 'RAINDOWN_WITHOUT_JSPI' => '1' }, 'node', File.join(ROOT, 'scripts', 'smoke.js'))
  run(*MISE, 'node', File.join(ROOT, 'scripts', 'jumps.js'), wasm, browser_bundle, STAGE)
  run('node', File.join(ROOT, 'scripts', 'smoke.js'))
  run(*MISE, 'node', File.join(ROOT, 'scripts', 'jumps.js'), wasm_jspi, browser_bundle, STAGE)
else
  puts 'Smoke test skipped: no Node, which CI runs it with'
end

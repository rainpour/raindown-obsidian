#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds main.js, which Obsidian loads, from src/, with Raindown inside it: packed with only the Ruby files it loads into
# ruby.wasm's module, Ruby compiled to WebAssembly, compressed with xz, in Z85, with ruby.wasm's browser bundle and the worker
# that runs it.
#   1. scripts/trace.rb writes back test/vault with a Raindown checkout, RAINDOWN_DIR or ../raindown, natively, and
#      lists what it wrote and the standard library files and gems that loaded, in build/loaded.json.
#   2. Those files, and src/engine.rb, are copied into build/root, as they'll be inside Ruby: the standard library at
#      /usr/local/lib/ruby, each gem at /gems/NAME and the engine at /engine.
#   3. With WASMTIME, each Ruby file's compiled to bytecode, at /bytecode, by ruby.wasm's WASI build, which is the same
#      Ruby as the module, so src/bytecode.rb loads it rather than its source, halving how long Raindown takes to load.
#      Its source is then left empty, so only its bytecode's packed.
#   4. rbwasm, from the ruby_wasm gem, packs build/root into ruby.wasm's module, as build/raindown.wasm. The module's
#      built by scripts/ruby_wasm.rb the first time, with only the extensions Raindown uses, which takes a while.
#   5. scripts/smoke.js runs main.js's worker on test/vault, with Node, and checks it wrote back what step 1 did. It's
#      skipped without Node, except in CI.
# Releases are built by CI, with Raindown at RAINDOWN_VERSION, and main.js isn't committed.
# ruby.wasm's WASI build and npm package are downloaded into build/runtime, or are RUBY_WASI and RUBY_NPM, and its
# module's built there, or is RUBY_WASM, with rbwasm and the js gem from wasm/Gemfile.
#   BUNDLE_GEMFILE=wasm/Gemfile bundle install
#   [RAINDOWN_DIR=../raindown] [WASMTIME=path/to/wasmtime] bin/build
require 'digest'
require 'fileutils'
require 'zlib'
require 'json'

RUBY_WASM_VERSION = '2.10.1'
# xz-decompress, which decompresses the module in the worker, as xz makes it a third smaller than gzip.
XZ_DECOMPRESS_VERSION = '0.2.3'
ROOT = File.expand_path('..', __dir__)
BUILD = File.join(ROOT, 'build')
STAGE = File.join(BUILD, 'root')
RAINDOWN = File.expand_path(ENV.fetch('RAINDOWN_DIR', '../raindown'), ROOT)
# Raindown's services for JavaScript nodes, which the worker answers, before its own code.
SERVICES = File.join(RAINDOWN, 'lib', 'raindown', 'js', 'services.js')
# The gems' Ruby is Raindown's own, which mise gives it, unless there's no mise, like in CI, with rbwasm installed into it.
def mise_exec
  return [] unless system('mise', '--version', out: File::NULL, err: File::NULL)

  %w[mise exec --]
end
MISE = mise_exec.freeze
BUNDLED = [*MISE, 'bundle', 'exec'].freeze
# rbwasm and the js gem, at RUBY_WASM_VERSION, for building ruby.wasm's module and packing Raindown into it.
WASM_GEMS = { 'BUNDLE_GEMFILE' => File.join(ROOT, 'wasm', 'Gemfile') }.freeze

# Z85, a base 85 with no quotes or backslashes, so it's a JavaScript string as it is, a fifteenth smaller than base64.
# The bytes are padded to a multiple of 4 with zeros, which the worker cuts off.
Z85 = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#'

def z85(bytes)
  padded = bytes + ("\0" * (-bytes.bytesize % 4))
  padded.unpack('N*').map { |number| 4.downto(0).map { Z85[(number / (85**it)) % 85] }.join }.join
end

def run(*command, chdir: ROOT)
  system(*command, chdir:, exception: true)
end

# The folder a release is extracted into in build/runtime, downloaded the first time.
def runtime(name, url)
  folder = File.join(BUILD, 'runtime', name)
  return folder if File.directory?(folder)

  FileUtils.mkdir_p(folder)
  run("curl -fsSL #{url} | tar -xz -C #{folder}")
  folder
end

def ruby_wasi
  ENV['RUBY_WASI'] || File.join(runtime('wasi', "https://github.com/ruby/ruby.wasm/releases/download/#{RUBY_WASM_VERSION}/" \
                                                 'ruby-3.4-wasm32-unknown-wasip1-full.tar.gz'), 'ruby-3.4-wasm32-unknown-wasip1-full')
end

# ruby.wasm's module, built with only the extensions Raindown uses, named by what it's built from, so a change to them
# builds it again.
def ruby_module
  return File.expand_path(ENV['RUBY_WASM']) if ENV['RUBY_WASM']

  inputs = %w[scripts/ruby_wasm.rb wasm/Gemfile.lock].map { File.read(File.join(ROOT, it)) }.join
  path = File.join(BUILD, 'module', "ruby-#{Digest::SHA256.hexdigest(inputs)[0, 12]}.wasm")
  return path if File.exist?(path)

  FileUtils.mkdir_p(File.dirname(path))
  run(WASM_GEMS.merge('RUBY_WASM_ROOT' => File.join(BUILD, 'ruby_wasm')), *BUNDLED, 'ruby', File.join(ROOT, 'scripts', 'ruby_wasm.rb'), path)
  path
end

# xz-decompress's script, which defines XzReadableStream: xz-embedded, compiled to WebAssembly, inside it.
def xz_decompress
  File.join(runtime('xz', "https://registry.npmjs.org/xz-decompress/-/xz-decompress-#{XZ_DECOMPRESS_VERSION}.tgz"),
            'package', 'dist', 'package', 'xz-decompress.min.js')
end

def ruby_npm
  ENV['RUBY_NPM'] || File.join(runtime('npm', "https://registry.npmjs.org/@ruby/3.4-wasm-wasi/-/3.4-wasm-wasi-#{RUBY_WASM_VERSION}.tgz"),
                               'package', 'dist')
end

def copy(from, to)
  FileUtils.mkdir_p(File.dirname(to))
  FileUtils.cp_r(from, to)
end

# 1. What loads.
loaded_file = File.join(BUILD, 'loaded.json')
FileUtils.mkdir_p(BUILD)
run(*BUNDLED, 'ruby', '-rrbconfig', '-I', File.join(ROOT, 'src'), File.join(ROOT, 'scripts', 'trace.rb'), loaded_file, chdir: RAINDOWN)
loaded = JSON.parse(File.read(loaded_file))

# 2. Staged as inside Ruby.
FileUtils.rm_rf(STAGE)
stdlib = File.join(ruby_wasi, 'usr', 'local', 'lib', 'ruby', '3.4.0')
loaded['stdlib'].each { copy(File.join(stdlib, it), File.join(STAGE, 'usr', 'local', 'lib', 'ruby', '3.4.0', it)) }
load_paths = ['/engine']
loaded['gems'].each do |name, gem|
  # Only the files that loaded, and gem data, like unicode-display_width's tables, beside its code.
  gem['files'].each { copy(File.join(gem['root'], it), File.join(STAGE, 'gems', name, it)) }
  data = File.join(gem['root'], 'data')
  copy(data, File.join(STAGE, 'gems', name, 'data')) if File.directory?(data)
  load_paths.concat(gem['require_paths'].map { "/gems/#{name}/#{it}" })
end
%w[engine.rb bytecode.rb worker.rb].each { copy(File.join(ROOT, 'src', it), File.join(STAGE, 'engine', it)) }

# Files Ruby loads before src/bytecode.rb, from their source, which is kept, as are those Raindown reads as text, like
# Lowkey's for a class that includes LowType, which scripts/trace.rb lists.
BEFORE_BYTECODE = %w[rbconfig.rb].freeze

# 3. Bytecode, with build/root as Ruby's / and scripts/ for compile.rb, for only the files that loaded, as the rest are
# rarely loaded, and they're compiled from source when they are.
folders = %w[usr gems engine]
if ENV['WASMTIME']
  compiled = loaded['stdlib'].map { "/usr/local/lib/ruby/3.4.0/#{it}" } + ['/engine/engine.rb'] +
             loaded['gems'].flat_map { |name, gem| gem['files'].map { "/gems/#{name}/#{it}" } }
  File.write(File.join(BUILD, 'compile.txt'), compiled.join("\n"))
  run(ENV['WASMTIME'], 'run', '--dir', "#{STAGE}::/", '--dir', "#{File.join(ROOT, 'scripts')}::/scripts",
      '--dir', "#{BUILD}::/build", File.join(ruby_wasi, 'usr', 'local', 'bin', 'ruby'), '--disable-gems',
      '/scripts/compile.rb', '/bytecode', '/build/compile.txt')
  folders << 'bytecode'
  # Only the bytecode's packed, as each source file's left empty, which Ruby still needs to find it to require it.
  # A file that failed to compile keeps its source.
  emptied = compiled.count do |file|
    next false if BEFORE_BYTECODE.include?(File.basename(file)) || loaded['read'].include?(file)
    next false unless File.exist?(File.join(STAGE, 'bytecode', "#{file}.yarb"))

    File.write(File.join(STAGE, file), '')
  end
  puts "Packed #{emptied} files as bytecode only"
end

# 4. Packed.
wasm = File.join(BUILD, 'raindown.wasm')
run(WASM_GEMS, *BUNDLED, 'rbwasm', 'pack', ruby_module, '-o', wasm,
    *folders.flat_map { ['--dir', "#{File.join(STAGE, it)}::/#{it}"] }, chdir: RAINDOWN)

# main.js, with the worker's code after Raindown's services.js. The browser bundle only gives DefaultRubyVM, which can't take Ruby's arguments, so it gives RubyVM and the
# WASI classes too. Each of src/'s files is a module, as Node would load it, for Obsidian, which loads one file.
browser = File.read(File.join(ruby_npm, 'browser.umd.js'))
browser = browser.sub('exports.DefaultRubyVM = DefaultRubyVM;') do
  'exports.DefaultRubyVM = DefaultRubyVM; Object.assign(exports, { RubyVM, WASI, OpenFile, File, PreopenDirectory, Directory });'
end
abort "ruby.wasm's browser bundle no longer exports DefaultRubyVM where it did" unless browser.include?('Object.assign(exports, { RubyVM')
# Compressed with xz, which xz-embedded decompresses, with a CRC-32 check, as it can't check SHA-256.
run('xz', '--format=xz', '--check=crc32', '-9e', '--keep', '--force', wasm)
worker = [browser, File.read(xz_decompress), File.read(SERVICES), File.read(File.join(ROOT, 'src', 'worker.js'))].join("\n")
compressed = File.binread("#{wasm}.xz")
runtime = { wasm: z85(compressed), wasmSize: compressed.bytesize, worker:, loadPaths: load_paths }
# The module compressed with gzip too, for scripts/smoke.js to time starting with it against xz.
gzipped = Zlib.gzip(File.binread(wasm), level: 9)
File.write(File.join(BUILD, 'gzip.json'), JSON.generate(wasm: z85(gzipped), wasmSize: gzipped.bytesize, compression: 'gzip'))
sources = { './runtime' => "module.exports = #{JSON.generate(runtime)};",
            './engine' => File.read(File.join(ROOT, 'src', 'engine.js')),
            './plugin' => File.read(File.join(ROOT, 'src', 'plugin.js')) }
modules = sources.map { |name, code| "#{JSON.generate(name)}: function (module, exports, require) {\n#{code}\n}" }
File.write(File.join(ROOT, 'main.js'), <<~JS)
  'use strict';

  // Built by bin/build from src/, with Raindown packed into Ruby compiled to WebAssembly. Edit src/, rather than this.
  const sources = {
  #{modules.join(",\n")}
  };
  const loaded = {};
  function load(name) {
    if (!sources[name]) return require(name);
    if (!loaded[name]) {
      loaded[name] = { exports: {} };
      sources[name](loaded[name], loaded[name].exports, load);
    }
    return loaded[name].exports;
  }
  module.exports = load('./plugin');
JS
puts format('Built main.js: %.2f MB, with Raindown packed into %.2f MB', File.size(File.join(ROOT, 'main.js')) / 1e6, File.size(wasm) / 1e6)
puts format('main.js with gzip would be %.2f MB', (File.size(File.join(ROOT, 'main.js')) - runtime[:wasm].bytesize + z85(gzipped).bytesize) / 1e6)
# Node runs the smoke test, which CI has, so a release is always checked, but working on the plugin doesn't need it.
if ENV['CI'] || system('node', '--version', out: File::NULL, err: File::NULL)
  run('node', File.join(ROOT, 'scripts', 'smoke.js'))
else
  puts 'Smoke test skipped: no Node, which CI runs it with'
end

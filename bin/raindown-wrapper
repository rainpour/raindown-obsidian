#!/bin/sh
# For local development, copy this to ~/.local/bin and set the plugin's Raindown command to its full path, like
# /Users/you/.local/bin/raindown-wrapper:
#   cp bin/raindown-wrapper ~/.local/bin/
#
# Runs a checkout of Raindown, in ~/dev/raindown or RAINDOWN_DIR, for testing the plugin before a release. Ruby 3.4.2
# comes first on the PATH, since bundle and bin/raindown run whichever ruby does, and Obsidian's PATH only has macOS's
# Ruby 2.6. Turn the plugin off and on after changing Raindown, as its server keeps the old code loaded.
RAINDOWN_DIR="${RAINDOWN_DIR:-$HOME/dev/raindown}"
export PATH="$HOME/.local/share/mise/installs/ruby/3.4.2/bin:$PATH"
export BUNDLE_GEMFILE="$RAINDOWN_DIR/Gemfile"
exec bundle exec "$RAINDOWN_DIR/bin/raindown" "$@"

+#if defined(__wasm__) && !defined(__EMSCRIPTEN__)
 /*
+  A function run under a tag, as EC_EXEC_TAG() runs what follows it, but
+  without setjmp, which unwinds every call frame to the root and rewinds
+  them to capture where it is, each time it's called. A jump to the tag
+  instead unwinds only to here, as vm_exec's does, and its state is
+  returned, or TAG_NONE. The function is given its tag's state when a
+  jump from it is caught, so it's called again for each jump, as the code
+  after EC_EXEC_TAG() is run again.
+*/
+struct rb_wasm_tag_run {
+    rb_execution_context_t *ec;
+    void (*func)(void *arg, enum ruby_tag_type state);
+    void *arg;
+};
+
+static inline void
+rb_wasm_tag_run_main(void *context)
+{
+    struct rb_wasm_tag_run *run = context;
+    run->func(run->arg, TAG_NONE);
+}
+
+static inline void
+rb_wasm_tag_run_rescue(void *context)
+{
+    struct rb_wasm_tag_run *run = context;
+    run->func(run->arg, rb_ec_tag_state(run->ec));
+}
+
+static inline void
+rb_wasm_ec_tag_run(rb_execution_context_t *ec, struct rb_vm_tag *tag,
+                   void (*func)(void *arg, enum ruby_tag_type state), void *arg)
+{
+    struct rb_wasm_tag_run run = { ec, func, arg };
+    struct rb_wasm_try_catch try_catch;
+
+    ec->tag = tag;
+    rb_wasm_try_catch_init(&try_catch, rb_wasm_tag_run_main, rb_wasm_tag_run_rescue, &run);
+    rb_wasm_try_catch_loop_run(&try_catch, &RB_VM_TAG_JMPBUF_GET(tag->buf));
+}
+#endif

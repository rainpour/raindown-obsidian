 #endif
--- a/wasm/missing.c
+++ b/wasm/missing.c
@@ -190,3 +190,62 @@
     errno = ENOTSUP;
     return -1;
 }
+
+#if defined(RB_WASM_EH) && __clang_major__ < 19
+/*
+  LLVM 18's setjmp on WebAssembly exceptions, as Emscripten's runtime gave it, which wasi-sdk 24's libsetjmp, for
+  LLVM 19's, doesn't: each setjmp in a function is given an ID, kept in its jmp_buf, and a label, in a table the
+  function keeps, which a longjmp's catch looks its ID up in, to jump to the label.
+*/
+#include <stdint.h>
+#include <stdlib.h>
+
+struct rb_wasm_setjmp_entry { uint32_t id, label; };
+
+static uint32_t rb_wasm_setjmp_id;
+static uint32_t rb_wasm_temp_ret0;
+
+struct rb_wasm_setjmp_entry *
+saveSetjmp(uint32_t *env, uint32_t label, struct rb_wasm_setjmp_entry *table, uint32_t size)
+{
+    *env = ++rb_wasm_setjmp_id;
+    for (uint32_t i = 0; i < size; i++) {
+        if (table[i].id == 0) {
+            table[i] = (struct rb_wasm_setjmp_entry){ rb_wasm_setjmp_id, label };
+            table[i + 1].id = 0;
+            rb_wasm_temp_ret0 = size;
+            return table;
+        }
+    }
+    size *= 2;
+    table = realloc(table, sizeof(*table) * (size + 1));
+    table[size / 2] = (struct rb_wasm_setjmp_entry){ rb_wasm_setjmp_id, label };
+    table[size / 2 + 1].id = 0;
+    rb_wasm_temp_ret0 = size;
+    return table;
+}
+
+uint32_t
+testSetjmp(uint32_t id, struct rb_wasm_setjmp_entry *table, uint32_t size)
+{
+    for (uint32_t i = 0; i < size && table[i].id; i++) {
+        if (table[i].id == id) return table[i].label;
+    }
+    return 0;
+}
+
+uint32_t
+getTempRet0(void)
+{
+    return rb_wasm_temp_ret0;
+}
+#endif
+
+#ifdef RB_WASM_EH
+#include "wasm/asyncify.h"
+
+void asyncify_start_unwind(void *buf) { (void)buf; __builtin_trap(); }
+void asyncify_stop_unwind(void) { rb_asyncify_unwind_buf = 0; }
+void asyncify_start_rewind(void *buf) { (void)buf; __builtin_trap(); }
+void asyncify_stop_rewind(void) { __builtin_trap(); }
+#endif

--- a/wasm/fiber.c
+++ b/wasm/fiber.c
@@ -7,6 +7,53 @@
  * This Asyncify based implementation is not much efficient and will be replaced with future stack-switching feature.
  */
 
+#ifdef RB_WASM_EH
+#include <stddef.h>
+/*
+  Without Asyncify, each Fiber is a stack of JSPI's, JavaScript Promise Integration: the JavaScript that instantiates
+  Ruby gives rb_wasm_jspi.switch as a WebAssembly.Suspending, which suspends the stack that calls it, until something
+  switches back to it, and resumes the stack switched to, or starts a new Fiber's, by calling
+  rb_wasm_jspi_fiber_start through WebAssembly.promising. So Fibers can only switch in Ruby that JavaScript called
+  through WebAssembly.promising, like rb_wasm_jspi_eval.
+*/
+#include "wasm/fiber.h"
+
+__attribute__((import_module("rb_wasm_jspi"), import_name("switch")))
+void rb_wasm_jspi_switch(rb_wasm_fiber_context *from, rb_wasm_fiber_context *to, int start);
+
+void
+rb_wasm_init_context(rb_wasm_fiber_context *fcp, void (*func)(void *, void *), void *arg0, void *arg1)
+{
+    fcp->entry_point = func;
+    fcp->arg0 = arg0;
+    fcp->arg1 = arg1;
+    fcp->is_rewinding = false;
+    fcp->is_started = false;
+}
+
+void
+rb_wasm_swapcontext(rb_wasm_fiber_context *ofcp, rb_wasm_fiber_context *fcp)
+{
+    int start = !fcp->is_started;
+    fcp->is_started = true;
+    rb_wasm_jspi_switch(ofcp, fcp, start);
+}
+
+__attribute__((export_name("rb_wasm_jspi_fiber_start")))
+void
+rb_wasm_jspi_fiber_start(rb_wasm_fiber_context *fcp)
+{
+    fcp->entry_point(fcp->arg0, fcp->arg1);
+}
+
+void *
+rb_wasm_handle_fiber_unwind(void (**new_fiber_entry)(void *, void *),
+                            void **arg0, void **arg1, bool *is_new_fiber_started)
+{
+    *is_new_fiber_started = false;
+    return NULL;
+}
+#else
 #include <stdlib.h>
 #include "wasm/fiber.h"
 #include "wasm/asyncify.h"
@@ -81,3 +128,4 @@
         return &next_fiber->asyncify_buf;
     }
 }
+#endif
--- a/wasm/missing.c
+++ b/wasm/missing.c
@@ -190,3 +190,47 @@
     errno = ENOTSUP;
     return -1;
 }
+
+#ifdef RB_WASM_EH
+#include "wasm/asyncify.h"
+
+void asyncify_start_unwind(void *buf) { (void)buf; __builtin_trap(); }
+void asyncify_stop_unwind(void) { rb_asyncify_unwind_buf = 0; }
+void asyncify_start_rewind(void *buf) { (void)buf; __builtin_trap(); }
+void asyncify_stop_rewind(void) { __builtin_trap(); }
+#endif
+
+#ifdef RB_WASM_EH
+/*
+  Ruby that waits for JavaScript without Asyncify, with JSPI: rb_wasm_jspi_eval runs RbWasmJSPI.run, which JavaScript
+  calls through WebAssembly.promising, and RbWasmJSPI.wait(id), which rb_wasm_jspi_define defines, calls
+  rb_wasm_jspi.await, a WebAssembly.Suspending, which suspends the stack until the promise JavaScript keeps by its id
+  settles, and gives whether it failed.
+*/
+#include "ruby/ruby.h"
+
+__attribute__((import_module("rb_wasm_jspi"), import_name("await")))
+int rb_wasm_jspi_await(int id);
+
+static VALUE
+rb_wasm_jspi_wait(VALUE self, VALUE id)
+{
+    return rb_wasm_jspi_await(NUM2INT(id)) ? Qtrue : Qfalse;
+}
+
+__attribute__((export_name("rb_wasm_jspi_define")))
+void
+rb_wasm_jspi_define(void)
+{
+    rb_define_module_function(rb_define_module("RbWasmJSPI"), "wait", rb_wasm_jspi_wait, 1);
+}
+
+__attribute__((export_name("rb_wasm_jspi_eval")))
+int
+rb_wasm_jspi_eval(void)
+{
+    int state = 0;
+    rb_eval_string_protect("RbWasmJSPI.run", &state);
+    return state;
+}
+#endif

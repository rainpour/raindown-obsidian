+// Garbage collected between requests, with no Ruby on the stack, where the module without Asyncify can, if Ruby wanted
+// to while it ran.
+function collectGarbage() {
+  if (!collect) return;
+
+  const began = performance.now();
+  if (collect()) Object.assign(collected, { count: collected.count + 1, ms: performance.now() - began });
+}

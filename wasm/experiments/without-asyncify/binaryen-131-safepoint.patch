+  // The calls in a function in a try, which resume when it catches.
+  static std::unordered_set<Expression*> callsInTry(Function* func) {
+    std::unordered_set<Expression*> found;
+    auto add = [&](Expression* body) {
+      for (auto* call : FindAll<Call>(body).list) {
+        found.insert(call);
+      }
+      for (auto* call : FindAll<CallIndirect>(body).list) {
+        found.insert(call);
+      }
+    };
+    for (auto* curr : FindAll<Try>(func->body).list) {
+      add(curr->body);
+    }
+    for (auto* curr : FindAll<TryTable>(func->body).list) {
+      add(curr->body);
+    }
+    return found;
+  }
+
+  // The calls in a function that never return, as unreachable follows them.
+  static std::unordered_set<Expression*> callsNotReturning(Function* func) {
+    std::unordered_set<Expression*> found;
+    for (auto* block : FindAll<Block>(func->body).list) {
+      auto& list = block->list;
+      for (Index i = 0; i + 1 < list.size(); i++) {
+        if (!list[i + 1]->is<Unreachable>()) {
+          continue;
+        }
+        auto* curr = list[i];
+        if (auto* drop = curr->dynCast<Drop>()) {
+          curr = drop->value;
+        } else if (auto* set = curr->dynCast<LocalSet>()) {
+          curr = set->value;
+        }
+        if (curr->is<Call>() || curr->is<CallIndirect>()) {
+          found.insert(curr);
+        }
+      }
+    }
+    return found;
+  }

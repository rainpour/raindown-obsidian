+  // Functions reach garbage collection through what they call: directly, or
+  // indirectly through any function of the call's type in a table, or an
+  // import other than WASI's, which can call back in. Calls to the functions
+  // spill-pointers-cut names, separated by commas, are taken not to reach it,
+  // as when they only collect when they're called from one that does.
+  std::shared_ptr<std::unordered_set<Name>> findCanCollect(Module* module) {
+    auto& found = reach();
+    std::unordered_set<Name> roots;
+    std::stringstream names(getArgumentOrDefault("spill-pointers-gc", ""));
+    std::string name;
+    while (std::getline(names, name, ',')) {
+      if (module->getFunctionOrNull(Name(name))) {
+        roots.insert(Name(name));
+      }
+    }
+    if (roots.empty()) {
+      return nullptr;
+    }
+    std::unordered_set<Name> cut;
+    std::stringstream cutNames(getArgumentOrDefault("spill-pointers-cut", ""));
+    while (std::getline(cutNames, name, ',')) {
+      cut.insert(Name(name));
+    }
+    // Who calls each function, and each type indirectly: in a try, or
+    // returning, or not.
+    enum Kind { InTry, Returning, NotReturning };
+    std::unordered_map<Name, std::vector<std::pair<Name, Kind>>> callers;
+    std::unordered_map<HeapType, std::vector<std::pair<Name, Kind>>>
+      typeCallers;
+    for (auto& func : module->functions) {
+      if (func->imported()) {
+        if (func->module != "wasi_snapshot_preview1" &&
+            func->module != "canonical_abi") {
+          roots.insert(func->name);
+        }
+        continue;
+      }
+      if (!FindAll<CallRef>(func->body).list.empty()) {
+        roots.insert(func->name);
+      }
+      auto inTry = callsInTry(func.get());
+      auto notReturning = callsNotReturning(func.get());
+      auto kind = [&](Expression* call) {
+        return inTry.contains(call)          ? InTry
+               : notReturning.contains(call) ? NotReturning
+                                             : Returning;
+      };
+      for (auto* call : FindAll<CallIndirect>(func->body).list) {
+        typeCallers[call->heapType].push_back({func->name, kind(call)});
+      }
+      for (auto* call : FindAll<Call>(func->body).list) {
+        if (!cut.contains(call->target)) {
+          callers[call->target].push_back({func->name, kind(call)});
+        }
+      }
+    }
+    std::unordered_map<Name, HeapType> tableTypes;
+    ElementUtils::iterAllElementFunctionNames(module, [&](Name name) {
+      tableTypes.emplace(name, module->getFunction(name)->type.getHeapType());
+    });
+    // Each function reached, from those that reach it, through the calls that
+    // count: all of them for any, and those that return, or are in a try of a
+    // function that reaches it at all, for returning.
+    std::unordered_map<Name, Name> via;
+    auto spread = [&](std::unordered_set<Name>& set,
+                      std::unordered_set<HeapType>& types,
+                      std::vector<Name> work,
+                      auto counts) {
+      while (!work.empty()) {
+        auto at = work.back();
+        work.pop_back();
+        std::vector<std::pair<Name, Kind>> reached = callers[at];
+        auto table = tableTypes.find(at);
+        if (table != tableTypes.end() && types.insert(table->second).second) {
+          auto& more = typeCallers[table->second];
+          reached.insert(reached.end(), more.begin(), more.end());
+        }
+        for (auto [caller, kind] : reached) {
+          if (counts(kind) && set.insert(caller).second) {
+            via[caller] = at;
+            work.push_back(caller);
+          }
+        }
+      }
+    };
+    found.any = roots;
+    spread(found.any,
+           found.anyTypes,
+           {roots.begin(), roots.end()},
+           [](Kind) { return true; });
+    found.returning = roots;
+    std::vector<Name> work(roots.begin(), roots.end());
+    // A call in a try to a function that can reach it at all, or of a type
+    // that can, returns to its caller after it collects.
+    for (auto& [callee, list] : callers) {
+      if (found.any.contains(callee)) {
+        for (auto [caller, kind] : list) {
+          if (kind == InTry && found.returning.insert(caller).second) {
+            work.push_back(caller);
+          }
+        }
+      }
+    }
+    for (auto& [type, list] : typeCallers) {
+      if (found.anyTypes.contains(type)) {
+        for (auto [caller, kind] : list) {
+          if (kind == InTry && found.returning.insert(caller).second) {
+            work.push_back(caller);
+          }
+        }
+      }
+    }
+    via.clear();
+    spread(found.returning,
+           found.returningTypes,
+           work,
+           [](Kind kind) { return kind == Returning; });
+    // SPILL_POINTERS_WHY, functions separated by commas, says how each can.
+    if (auto* why = getenv("SPILL_POINTERS_WHY")) {
+      std::stringstream asked(why);
+      while (std::getline(asked, name, ',')) {
+        std::cerr << name;
+        for (Name at(name); via.contains(at); at = via[at]) {
+          std::cerr << " <- " << via[at];
+        }
+        std::cerr << (found.returning.contains(Name(name)) ? "\n"
+                                                           : " (can't)\n");
+      }
+    }
+    return std::make_shared<std::unordered_set<Name>>(found.returning);
+  }

+  // The locals that can't be pointers into the heap, assuming each can't
+  // until it's set to something that can be.
+  std::unordered_set<Index> findNotPointers(Function* func) {
+    std::unordered_set<Index> notPointers;
+    for (Index i = func->getNumParams(); i < func->getNumLocals(); i++) {
+      notPointers.insert(i);
+    }
+    auto sets = FindAll<LocalSet>(func->body).list;
+    bool changed = true;
+    while (changed) {
+      changed = false;
+      for (auto* set : sets) {
+        if (notPointers.contains(set->index) &&
+            !isNotPointer(set->value, notPointers)) {
+          notPointers.erase(set->index);
+          changed = true;
+        }
+      }
+    }
+    return notPointers;
+  }

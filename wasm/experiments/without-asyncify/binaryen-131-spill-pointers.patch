+  // The locals that can't be pointers into the heap, assuming each can't
+  // until it's set to something that can be.
+  std::unordered_set<Index> findNotPointers(Function* func) {
+    std::unordered_set<Index> notPointers;
+    for (Index i = func->getNumParams(); i < func->getNumLocals(); i++) {
+      notPointers.insert(i);
+    }
+    auto sets = FindAll<LocalSet>(func->body).list;
+    bool changed = true;
+    while (changed) {
+      changed = false;
+      for (auto* set : sets) {
+        if (notPointers.contains(set->index) &&
+            !isNotPointer(set->value, notPointers)) {
+          notPointers.erase(set->index);
+          changed = true;
+        }
+      }
+    }
+    return notPointers;
+  }
+
+  static bool isSmall(Expression* curr) {
+    auto* c = curr->dynCast<Const>();
+    return c && c->type == Type::i32 && c->value.geti32() >= 0 &&
+           c->value.geti32() < 65536;
+  }
+
+  bool isNotPointer(Expression* curr,
+                    const std::unordered_set<Index>& notPointers) {
+    if (curr->is<Const>()) {
+      return true;
+    }
+    if (auto* get = curr->dynCast<LocalGet>()) {
+      return notPointers.contains(get->index);
+    }
+    if (auto* tee = curr->dynCast<LocalSet>()) {
+      return isNotPointer(tee->value, notPointers);
+    }
+    if (auto* load = curr->dynCast<Load>()) {
+      return load->bytes < 4 && !load->signed_;
+    }
+    if (auto* unary = curr->dynCast<Unary>()) {
+      return unary->isRelational() || unary->op == ClzInt32 ||
+             unary->op == CtzInt32 || unary->op == PopcntInt32;
+    }
+    if (auto* binary = curr->dynCast<Binary>()) {
+      if (binary->isRelational()) {
+        return true;
+      }
+      if (binary->op == AndInt32) {
+        return isSmall(binary->left) || isSmall(binary->right);
+      }
+      if (binary->op == ShrUInt32) {
+        auto* c = binary->right->dynCast<Const>();
+        return c && (c->value.geti32() & 31) >= 16;
+      }
+      return false;
+    }
+    if (auto* select = curr->dynCast<Select>()) {
+      return isNotPointer(select->ifTrue, notPointers) &&
+             isNotPointer(select->ifFalse, notPointers);
+    }
+    return false;
+  }

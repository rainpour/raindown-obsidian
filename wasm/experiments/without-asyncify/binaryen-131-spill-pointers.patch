Binaryen 131's --spill-pointers, spilling less for Ruby without Asyncify, an experiment the plugin doesn't use, as
docs/adr/0006 in Raindown's repo says: about 2% on a note of heavy Ruby, and 60 KB of the module, for a Binaryen built
from source in the plugin's build.

Applied to Binaryen's source, as cd binaryen-version_131 && patch -p1 < this, then
  cmake -S . -B build -DBUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release && cmake --build build --target wasm-opt
and run in place of the configure's --spill-pointers as
  --flatten --coalesce-locals --spill-pointers \
    --pass-arg=spill-pointers-gc@rb_gc_mark_roots,rb_gc_mark_locations,each_location,gc_start -O3
with SPILL_POINTERS_DEBUG set to say how many functions can collect. gc_reach.rb counts the same from the module's
text.

--- a/src/passes/SpillPointers.cpp
+++ b/src/passes/SpillPointers.cpp
@@ -25,8 +25,28 @@
 //  * There is currently no check that there is enough stack space.
 //
 
+// Spilling less, for Ruby in WebAssembly, whose garbage collection reads the stack:
+//
+//  * A call to a function that can't reach garbage collection isn't spilled
+//    around: one that can is one of the functions the pass-arg
+//    spill-pointers-gc names, separated by commas, like those that read the
+//    stack, or an import other than WASI's, or makes an indirect call, or
+//    calls such a function. Without any of them, every call's spilled around,
+//    as before.
+//  * A local that can't be a pointer into the heap isn't spilled: one only
+//    set to constants, comparisons, loads of fewer than 4 bytes, values masked
+//    or shifted below 64 KB, or locals like it. Parameters can be anything.
+//  * A local already spilled at an earlier call in the block, and not set
+//    since, isn't spilled again, as its place on the stack has it.
+
+#include <cstdlib>
+#include <mutex>
+#include <iostream>
+#include <sstream>
+
 #include "abi/stack.h"
 #include "cfg/liveness-traversal.h"
+#include "ir/find_all.h"
 #include "pass.h"
 #include "wasm-builder.h"
 #include "wasm.h"
@@ -40,10 +60,77 @@
   // Adds writes to memory.
   bool addsEffects() override { return true; }
 
+  // The functions that can reach garbage collection, or null, for every
+  // function, found once for the module, as each function's walked in
+  // parallel, by its own instance of the pass.
+  std::shared_ptr<std::unordered_set<Name>> canCollect;
+
   std::unique_ptr<Pass> create() override {
     return std::make_unique<SpillPointers>();
   }
 
+  std::shared_ptr<std::unordered_set<Name>> canCollectIn(Module* module) {
+    static std::mutex mutex;
+    static std::unordered_map<Module*,
+                              std::shared_ptr<std::unordered_set<Name>>>
+      found;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto [entry, added] = found.try_emplace(module);
+    if (added) {
+      entry->second = findCanCollect(module);
+      if (getenv("SPILL_POINTERS_DEBUG")) {
+        std::cerr << "spill-pointers: "
+                  << (entry->second ? std::to_string(entry->second->size())
+                                    : std::string("all"))
+                  << " of " << module->functions.size()
+                  << " functions can collect\n";
+      }
+    }
+    return entry->second;
+  }
+
+  std::shared_ptr<std::unordered_set<Name>> findCanCollect(Module* module) {
+    auto found = std::make_shared<std::unordered_set<Name>>();
+    std::stringstream names(getArgumentOrDefault("spill-pointers-gc", ""));
+    std::string name;
+    while (std::getline(names, name, ',')) {
+      if (module->getFunctionOrNull(Name(name))) {
+        found->insert(Name(name));
+      }
+    }
+    if (found->empty()) {
+      return nullptr;
+    }
+    std::unordered_map<Name, std::vector<Name>> callers;
+    for (auto& func : module->functions) {
+      if (func->imported()) {
+        if (func->module != "wasi_snapshot_preview1" &&
+            func->module != "canonical_abi") {
+          found->insert(func->name);
+        }
+        continue;
+      }
+      if (!FindAll<CallIndirect>(func->body).list.empty() ||
+          !FindAll<CallRef>(func->body).list.empty()) {
+        found->insert(func->name);
+      }
+      for (auto* call : FindAll<Call>(func->body).list) {
+        callers[call->target].push_back(func->name);
+      }
+    }
+    std::vector<Name> work(found->begin(), found->end());
+    while (!work.empty()) {
+      auto name = work.back();
+      work.pop_back();
+      for (auto caller : callers[name]) {
+        if (found->insert(caller).second) {
+          work.push_back(caller);
+        }
+      }
+    }
+    return found;
+  }

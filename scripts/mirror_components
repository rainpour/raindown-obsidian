#!/bin/bash
# Fills in a checkout of rainpour/obsidian-components, Components' own repository, which Obsidian lists it from: its own
# files, like its README, from components/repository, with the plugin's license, and with a tag or commit, the plugin's
# source, as it is there, as Obsidian needs a plugin's source in its repository: what bin/build builds both plugins
# from, as git has it, replacing what was copied before, so a file deleted here goes there too. Only CI writes there:
# each push to main copies its files, and each release its source too.
#   scripts/mirror_components ../obsidian-components [0.11.2]
set -euo pipefail
target=$(cd "$1" && pwd)
ref=${2:-}
cd "$(dirname "$0")/.."
cp -R components/repository/. "$target"
cp LICENSE.txt "$target"
[ -z "$ref" ] && exit 0

paths=(src bin scripts wasm test components package.json .npmrc .ruby-version .tool-versions RAINDOWN_VERSION
  DEVELOPMENT.md styles.css version-bump.mjs)
for path in "${paths[@]}"; do rm -rf "${target:?}/$path"; done
git archive "$ref" -- "${paths[@]}" | tar -x -C "$target"
